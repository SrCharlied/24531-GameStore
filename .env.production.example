# Plantilla para .env de PRODUCCIÓN.
# En el servidor: cp .env.production.example .env  y luego editar lo necesario.
#
# IMPORTANTE: NO dejar comentarios al final de la misma línea de una variable.
# Generar APP_KEY antes del primer arranque con:
#   echo "base64:$(openssl rand -base64 32)"

APP_NAME=GameStore
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://gamestore.servigtdev.com

LOG_CHANNEL=stack
LOG_LEVEL=warning

DB_CONNECTION=pgsql
DB_HOST=db
DB_PORT=5432
DB_DATABASE=gamestore
DB_USERNAME=proy2
DB_PASSWORD=secret

# Sesión + cookies para HTTPS y dominio único
SESSION_DRIVER=file
SESSION_DOMAIN=gamestore.servigtdev.com
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax

SANCTUM_STATEFUL_DOMAINS=gamestore.servigtdev.com

QUEUE_CONNECTION=sync
CACHE_STORE=file

# Vacío: Vite construye con URLs relativas y Caddy enruta /api/* y /sanctum/*
VITE_API_URL=
